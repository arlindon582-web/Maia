#include <OneWire.h>
#include <DallasTemperature.h>

#define LED_PIN      12   
#define ONE_WIRE_BUS 11   // DS18B20 (Temperatura)
#define TURB_PIN     A0  // Turbidez
#define PH_PIN       A1  // Sensor de pH
#define TDS_PIN      A2  // Sensor de TDS

OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature sensors(&oneWire);

void setup() {
  Serial.begin(115200);
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW);
  sensors.begin();
}

void loop() {
  static unsigned long lastMsg = 0;
  
  if (millis() - lastMsg > 1000) {
    lastMsg = millis();

    // 1. Temperatura
    sensors.requestTemperatures();
    float tempC = sensors.getTempCByIndex(0);

    // 2. Turbidez (Leitura Bruta 0-1023)
    int turbidezRaw = analogRead(TURB_PIN);

    // 3. pH (Leitura Bruta 0-1023)
    int phRaw = analogRead(PH_PIN);

    // 4. TDS (Leitura Bruta 0-1023)
    int tdsRaw = analogRead(TDS_PIN);

    // Envio "cru" no formato: TEMP,TURBIDEZ,PH,TDS
    Serial.print("Temp: ");
    Serial.print(tempC);
    Serial.print(", Turb: ");
    Serial.print(turbidezRaw);
    Serial.print(", Ph: ");
    Serial.print(phRaw);
    Serial.print(", TDS: ");
    Serial.println(tdsRaw);
  }

  // Comandos LED via USB
  if (Serial.available() > 0) {
    String comando = Serial.readStringUntil('\n');
    comando.trim();
    if (comando == "ON") {
      digitalWrite(LED_PIN, HIGH);
    } else if (comando == "OFF") {
      digitalWrite(LED_PIN, LOW);
    }
  }
}
