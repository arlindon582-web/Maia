#include <OneWire.h>
#include <DallasTemperature.h>

#define LED_PIN      2   // Pino D2
#define ONE_WIRE_BUS 4   // Pino D4 (DS18B20)
#define TURB_PIN     A0  // Pino A0 (Turbidez)

OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature sensors(&oneWire);

void setup() {
  Serial.begin(115200);
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW);
  sensors.begin();
}

void loop() {
  static unsigned long lastMsg = 0;
  // Acelerei para 1 segundo para o debug ficar mais dinâmico
  if (millis() - lastMsg > 1000) {
    lastMsg = millis();

    // Leitura DS18B20
    sensors.requestTemperatures();
    float tempC = sensors.getTempCByIndex(0);

    // Leitura Turbidez
    int turbidezRaw = analogRead(TURB_PIN);

    // Envio "cru" (formato: TEMP,TURBIDEZ)
    // Se estiver desconectado, envia -127.00 que é o erro padrão
    Serial.print(tempC);
    Serial.print(",");
    Serial.println(turbidezRaw);
  }

  // --- Comando do LED via USB ---
  if (Serial.available() > 0) {
    String comando = Serial.readStringUntil('\n');
    comando.trim();
    if (comando == "ON") {
      digitalWrite(LED_PIN, HIGH);
    } else if (comando == "OFF") {
      digitalWrite(LED_PIN, LOW);
    }
  }
}
