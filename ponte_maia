import serial
import paho.mqtt.client as mqtt
import ssl
import time
import sys

# --- Credenciais e Tópicos do MAIA / HiveMQ ---
MQTT_BROKER = "b8f97f54560a45f8ae04c7624c7d7cd4.s1.eu.hivemq.cloud"
MQTT_PORT = 8883
MQTT_USER = "ufrb.maia.esp"
MQTT_PASSWORD = "Ma1a@hivemq"

# Novos tópicos para os sensores adicionais
TOPIC_TEMP = "esp8266/temperature"
TOPIC_TURB = "esp8266/turbidez"
TOPIC_PH = "esp8266/ph"
TOPIC_TDS = "esp8266/tds"
TOPIC_LED = "esp8266/led"

# --- 1. SELEÇÃO DE PORTA SERIAL ---
print("=== GATEWAY MAIA (PYTHON) ===")
print("Dica: No Windows use 'COM3', 'COM5'. No Linux use '/dev/ttyUSB0' ou '/dev/ttyACM0'")
SERIAL_PORT = input("Digite a porta do Arduino Nano: ").strip()
BAUD_RATE = 115200

try:
    arduino = serial.Serial(SERIAL_PORT, BAUD_RATE, timeout=1)
    print(f"🔌 Conectado ao Arduino na porta {SERIAL_PORT}")
except Exception as e:
    print(f"❌ Erro Crítico: Não foi possível abrir a porta {SERIAL_PORT}")
    print("Verifique se a Arduino IDE / Monitor Serial não está com a porta aberta!")
    sys.exit()

# --- 2. COMUNICAÇÃO MQTT ---
def on_connect(client, userdata, flags, rc):
    if rc == 0:
        print("🌐 Conectado com Sucesso à Nuvem do HiveMQ!")
        client.subscribe(TOPIC_LED) 
        print(f"👂 Escutando comandos do app MAIA no tópico: {TOPIC_LED}")
    else:
        print(f"⚠️ Falha na conexão ao HiveMQ. Código: {rc}")

def on_message(client, userdata, msg):
    comando = msg.payload.decode()
    print(f"\n📱 Recebido do App [{msg.topic}]: {comando}")
    
    if msg.topic == TOPIC_LED and comando in ["ON", "OFF"]:
        print(f"-> Repassando comando '{comando}' para o Arduino...")
        arduino.write((comando + '\n').encode())

client = mqtt.Client(client_id="Python_Gateway_Notebook")
client.username_pw_set(MQTT_USER, MQTT_PASSWORD)
client.tls_set(tls_version=ssl.PROTOCOL_TLS) 

client.on_connect = on_connect
client.on_message = on_message

print("⏳ Negociando conexão TLS com HiveMQ...")
client.connect(MQTT_BROKER, MQTT_PORT, 60)
client.loop_start() 

# --- 3. PROCESSAMENTO DOS DADOS MULTISENSOR ---
print("\n📡 Aguardando dados dos 4 sensores...")
try:
    while True:
        if arduino.in_waiting > 0:
            # Lê a linha completa enviada pelo Arduino
            linha = arduino.readline().decode('utf-8').strip()
            
            if linha:
                try:
                    # Exemplo esperado da linha: "Temp: 21.56, Turb: 594, Ph: 383, TDS: 1"
                    # O Arduino envia o formato amigável, então o Python vai extrair apenas os números
                    
                    partes = linha.split(',')
                    if len(partes) == 4:
                        # Extrai os valores numéricos pegando tudo após os dois pontos (":")
                        temp_str = partes[0].split(':')[1].strip()
                        turb_str = partes[1].split(':')[1].strip()
                        ph_str = partes[2].split(':')[1].strip()
                        tds_str = partes[3].split(':')[1].strip()
                        
                        print(f"📤 Publicando: 🌡️ Temp={temp_str}°C | 💧 Turbidez={turb_str} | 🧪 pH={ph_str} | 🧂 TDS={tds_str}")
                        
                        # Publica nos canais individuais
                        client.publish(TOPIC_TEMP, temp_str)
                        client.publish(TOPIC_TURB, turb_str)
                        client.publish(TOPIC_PH, ph_str)
                        client.publish(TOPIC_TDS, tds_str)
                except Exception as e:
                    print(f"⚠️ Erro ao decodificar a linha '{linha}': {e}")
        
        time.sleep(0.1)

except KeyboardInterrupt:
    print("\n🛑 Encerrando o sistema...")
    client.loop_stop()
    arduino.close()
